# Copy these into Vercel → Settings → Environment Variables
# NEVER commit real values to GitHub — secrets live only in Vercel.

# Admin panel login (required)
ADMIN_EMAIL=admin@vaagai.in
ADMIN_PASSWORD=change-to-a-strong-password
ADMIN_SECRET=change-to-a-long-random-string

# Upstash Redis (required for durable data on Vercel) — free at upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Email (optional but recommended) — Gmail App Password, not your normal one
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=vaagai2k26@gmail.com
EMAIL_PASS=your-16-char-app-password
CONTACT_TO=vaagai2k26@gmail.com

# Mail identity (optional — safe defaults are built in)
# Display name shown as the sender, e.g. "Vaagai 26 <vaagai2k26@gmail.com>".
# Keep it stable: changing the From name often hurts spam-folder placement.
MAIL_FROM_NAME=Vaagai 26
# Where participant replies go (defaults to CONTACT_TO, then EMAIL_USER).
MAIL_REPLY_TO=vaagai2k26@gmail.com
