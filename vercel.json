{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 20,
      "includeFiles": "VAAGAI26_*.pdf"
    },
    "api/register.js": { "maxDuration": 20 },
    "api/check-email.js": { "maxDuration": 10 },
    "api/health.js": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/register", "destination": "/api/register.js" },
    { "source": "/api/check-email", "destination": "/api/check-email.js" },
    { "source": "/api/health", "destination": "/api/health.js" },
    { "source": "/api/admin/:path*", "destination": "/api/index.js" },
    { "source": "/api/contact", "destination": "/api/index.js" },
    { "source": "/api/join-team", "destination": "/api/index.js" },
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
